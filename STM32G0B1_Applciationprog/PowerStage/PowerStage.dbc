BA_ "GenMsgSendType"  BO_ 1635 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1636 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1637 "Event";
BA_ "GenMsgSendType"  BO_ 1638 "Event";
BA_ "GenMsgSendType"  BO_ 1639 "Event";
BA_ "GenMsgSendType"  BO_ 1640 "Event";
BA_ "GenMsgSendType"  BO_ 1641 "Event";
BA_ "GenMsgSendType"  BO_ 1642 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1643 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1644 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1645 "Event";
BA_ "GenMsgSendType"  BO_ 1646 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1647 "Cyclic";
BA_ "GenMsgSendType"  BO_ 1648 "Cyclic";

VAL_ 1637 Fan_Mode        0 "OFF" 1 "ON_MANUAL" 2 "AUTO" ;
VAL_ 1638 HS_Cmd_AUX      0 "DISABLE" 1 "ENABLE" ;
VAL_ 1638 HS_Cmd_LED      0 "DISABLE" 1 "ENABLE" ;
VAL_ 1638 HS_Cmd_DRIVE    0 "DISABLE" 1 "ENABLE" ;
VAL_ 1638 HS_Cmd_CAP      0 "DISABLE" 1 "ENABLE" ;
VAL_ 1638 HS_Cmd_SBC      0 "DISABLE" 1 "ENABLE" ;
VAL_ 1639 Device_Command  255 "RESET_BOOTLOADER" ;
VAL_ 1640 OC_Cmd          1 "SET_THRESHOLD" 2 "RESET_FAULT" ;
VAL_ 1641 EEPROM_Cmd      1 "SAVE_CONFIG" 2 "LOAD_DEFAULT" ;
VAL_ 1642 Fan_Mode_State  0 "OFF" 1 "ON_MANUAL" 2 "AUTO" ;
VAL_ 1643 Cfg_Fan_Def_Mode 0 "OFF" 1 "ON_MANUAL" 2 "AUTO" ;

