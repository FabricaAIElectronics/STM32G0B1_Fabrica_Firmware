CM_ BU_ KincoDrive "KincoDrive Control Module V5.4 - Device ID 0x0667";
CM_ BU_ Host "Host controller / CAN analyzer";

CM_ BO_ 2165311079 "CMD 0x110: High-side power control. DLC=1. One bit per channel: 0=OFF 1=ON. All channels set in one frame.";
CM_ BO_ 2168456807 "CMD 0x140: Fan PWM speed. DLC=5. One byte per fan (0-100%). Bytes 0-4 = DR/EP/EH/ST/SF.";
CM_ BO_ 2181039719 "CMD 0x200: EEPROM config. DLC=1. Byte0: 0=Load hard-coded safe defaults (all OFF), 1=Save current HS/fan state to EEPROM. Device responds with Bcast_Config (0x606).";

CM_ BO_ 2248148583 "BCAST 0x600: Voltages and endstop/ESTOP summary. Period: 500 ms.";
CM_ BO_ 2248214119 "BCAST 0x601: 24V bus and per-module high-side currents. Period: 500 ms.";
CM_ BO_ 2248279655 "BCAST 0x602: 6 PTC thermistor temperatures. Wire: value = degC + 40. Period: 500 ms.";
CM_ BO_ 2248345191 "BCAST 0x603: Fan tachometer speed as % of 5000 RPM max. Period: 500 ms.";
CM_ BO_ 2248410727 "BCAST 0x604: GPIO pin states. All signals are direct pin reads. Period: 500 ms.";
CM_ BO_ 2248476263 "BCAST 0x605: Raw ADC, 12 channels packed as 4-bit nibbles (raw >> 8). Period: 500 ms.";
CM_ BO_ 2248541799 "BCAST 0x606: EEPROM startup defaults (HS on/off + fan %). Sent on startup and after any EEPROM command. Period: 500 ms.";

CM_ SG_ 2248410727 HS_DR_PwrGood "Active LOW inverted: 1=power good, 0=not good";
CM_ SG_ 2248410727 HS_E_PwrGood "Active LOW inverted: 1=power good, 0=not good";
CM_ SG_ 2248410727 HS_SC_PwrGood "Active LOW inverted: 1=power good, 0=not good";
CM_ SG_ 2248410727 HS_DR_Fault "Active LOW inverted: 1=fault active, 0=normal";
CM_ SG_ 2248410727 HS_E_Fault "Active LOW inverted: 1=fault active, 0=normal";
CM_ SG_ 2248410727 HS_SC_Fault "Active LOW inverted: 1=fault active, 0=normal";
CM_ SG_ 2248410727 ESTOP_NO_Pin "Raw NO input pin: 1=HIGH";
CM_ SG_ 2248410727 ESTOP_NC_Pin "Raw NC input pin: 1=HIGH";
CM_ SG_ 2248410727 ESTOP_Triggered "Debounced ESTOP state: 1=triggered";
CM_ SG_ 2248410727 ESTOP_WiringFault "1=NO/NC state inconsistent (wiring fault)";
CM_ SG_ 2248410727 EH_Top_NO "Extruder Head top endstop, NO contact: 1=HIGH";
CM_ SG_ 2248410727 EH_Bot_NO "Extruder Head bottom endstop, NO contact: 1=HIGH (NO-only switch)";
CM_ SG_ 2248410727 EP_Top_NO "Extruder Platform top endstop, NO contact: 1=HIGH";
CM_ SG_ 2248410727 EP_Bot_NO "Extruder Platform bottom endstop, NO contact: 1=HIGH";
CM_ SG_ 2248410727 SC_Top_NO "Scrubbing top endstop, NO contact: 1=HIGH";
CM_ SG_ 2248410727 EH_Top_NC "Extruder Head top endstop, NC contact: 1=HIGH";
CM_ SG_ 2248410727 EP_Top_NC "Extruder Platform top endstop, NC contact: 1=HIGH";
CM_ SG_ 2248410727 EP_Bot_NC "Extruder Platform bottom endstop, NC contact: 1=HIGH";
CM_ SG_ 2248410727 SC_Top_NC "Scrubbing top endstop, NC contact: 1=HIGH";
CM_ SG_ 2248410727 Dbg_ISR_Count "DEBUG: wrapping counter +1 each CAN frame received by ISR";
CM_ SG_ 2248148583 Endstop_Triggered "Bit0=EH_Top, Bit1=EH_Bot, Bit2=EP_Top, Bit3=EP_Bot, Bit4=SC_Top, Bit5=ESTOP";
CM_ SG_ 2248148583 Endstop_Fault "Same bit layout as Endstop_Triggered. 1=wiring fault detected.";
CM_ SG_ 2248148583 Dbg_Cmd_Count "DEBUG: wrapping counter +1 each command dispatched by CAN_Process";
CM_ SG_ 2248148583 Dbg_Last_MsgType "DEBUG: last message type processed (0x110=HS_Power, 0x140=Fan_PWM, 0x200=EEPROM)";
CM_ SG_ 2248476263 ADC_PTC1_PTC2 "Hi nibble=PTC1, Lo nibble=PTC2 (raw ADC >> 8)";
CM_ SG_ 2248476263 ADC_PTC3_PTC4 "Hi nibble=PTC3, Lo nibble=PTC4";
CM_ SG_ 2248476263 ADC_PTC5_PTC6 "Hi nibble=PTC5, Lo nibble=PTC6";
CM_ SG_ 2248476263 ADC_CURR1_CURR2 "Hi nibble=CURR_MON_1, Lo nibble=CURR_MON_2";
CM_ SG_ 2248476263 ADC_CURR3_V24 "Hi nibble=CURR_MON_3, Lo nibble=VADC_24";
CM_ SG_ 2248476263 ADC_V12_CURR24V "Hi nibble=VADC_12, Lo nibble=CURR_MON_24V";
CM_ SG_ 2248541799 Def_HS_DR "Saved default for Drive HS: 1=ON at boot";
CM_ SG_ 2248541799 Def_HS_E "Saved default for Extruder HS: 1=ON at boot";
CM_ SG_ 2248541799 Def_HS_SC "Saved default for Scrubbing HS: 1=ON at boot";
CM_ SG_ 2248541799 Def_VBUCK "Saved default for 12V Buck: 1=ON at boot";
CM_ SG_ 2248541799 Def_Fan_DR "Saved default Drive fan speed (0-100%) at boot";
CM_ SG_ 2248541799 Def_Fan_EP "Saved default Extruder Platform fan speed at boot";
CM_ SG_ 2248541799 Def_Fan_EH "Saved default Extruder Head fan speed at boot";
CM_ SG_ 2248541799 Def_Fan_ST "Saved default Stepper fan speed at boot";
CM_ SG_ 2248541799 Def_Fan_SF "Saved default Scrubbing Front fan speed at boot";

