CM_ BU_ Host "Supervisory host or CAN analyzer. Issues commands to the three Fabrica devices and consumes their broadcasts.";
CM_ BU_ KincoDrive "Fabrica KincoDrive Control Module V5.4. Standard 11-bit IDs in 0x101-0x12F. Bootloader RX 0x101 / TX 0x102.";
CM_ BU_ PowerStage "Fabrica PowerStage Controller. Standard 11-bit IDs in 0x130-0x15F. Bootloader RX 0x130 / TX 0x131. Dual-bus relay (FDCAN1 internal, FDCAN2 host).";
CM_ BU_ LEDDriver "Fabrica 3-channel LED Driver. Standard 11-bit IDs in 0x160-0x17F. Bootloader RX 0x160 / TX 0x161.";

CM_ BO_ 257 "0x101 KincoDrive bootloader RX. byte0=0xFF DLC=2 = XCP CONNECT (also resets running app into bootloader).";
CM_ BO_ 258 "0x102 KincoDrive bootloader TX (XCP responses).";
CM_ BO_ 275 "0x113 KincoDrive: per-channel OC thresholds, uint16 LE × 3 (DR/EXT/SC) in mA.";
CM_ BO_ 276 "0x114 KincoDrive: undervoltage thresholds, uint16 LE × 2 (V24/V12) in mV.";
CM_ BO_ 294 "0x126 KincoDrive: BCAST_CONFIG_A - HS boot state bits + OC thresholds from EEPROM.";
CM_ BO_ 295 "0x127 KincoDrive: BCAST_CONFIG_B - UV thresholds + fan boot defaults from EEPROM.";
CM_ SG_ 288 KD_Sys_State "0=INIT 1=LOAD_CONFIG 2=RUNNING";
CM_ SG_ 288 KD_Err_OC_DR "Drive rail OC fault latched (auto-disabled). Host re-enables via CMD_HS_POWER.";
CM_ SG_ 288 KD_Err_OC_EXT "Extruder rail OC fault latched.";
CM_ SG_ 288 KD_Err_OC_SC "Scrubbing rail OC fault latched.";
CM_ SG_ 288 KD_Err_UV_24V "24V bus undervoltage active (auto-clears with hysteresis).";
CM_ SG_ 288 KD_Err_UV_12V "12V bus undervoltage active (auto-clears with hysteresis).";
CM_ SG_ 294 KD_Cfg_HS_DR_Default "EEPROM boot default for HS_DR (drive) channel.";
CM_ SG_ 294 KD_Cfg_HS_E_Default "EEPROM boot default for HS_E (extruder) channel.";
CM_ SG_ 294 KD_Cfg_HS_SC_Default "EEPROM boot default for HS_SC (scrubbing) channel.";
CM_ SG_ 294 KD_Cfg_VBUCK_Default "EEPROM boot default for VBUCK (12V buck) enable.";
CM_ SG_ 292 KD_EStopLED_CTRL_Out "EStop LED control output state (PB15).";
CM_ SG_ 292 KD_EStop_NO_In "EStop NO contact raw input (PB13).";
CM_ SG_ 292 KD_EStop_NC_In "EStop NC contact raw input (PB14).";
CM_ SG_ 292 KD_Endstop_SC_H_NO_In "Scrubbing high endstop NO raw input (PD1).";
CM_ SG_ 292 KD_Endstop_SC_H_NC_In "Scrubbing high endstop NC raw input (PD2).";
CM_ SG_ 292 KD_Endstop_EP_L_NO_In "Extruder low endstop NO raw input (PD3).";
CM_ SG_ 292 KD_Endstop_EP_L_NC_In "Extruder low endstop NC raw input (PD4).";
CM_ SG_ 292 KD_Endstop_EP_H_NO_In "Extruder high endstop NO raw input (PD5).";
CM_ SG_ 292 KD_Endstop_EP_H_NC_In "Extruder high endstop NC raw input (PD6).";
CM_ SG_ 292 KD_Endstop_EH_L_NO1_In "Extruder heater low endstop NO1 raw input (PC11).";
CM_ SG_ 292 KD_Endstop_EH_L_NO_In "Extruder heater low endstop NO raw input (PB3).";
CM_ SG_ 292 KD_Endstop_EH_H_NO_In "Extruder heater high endstop NO raw input (PB4).";
CM_ SG_ 292 KD_Endstop_EH_H_NC_In "Extruder heater high endstop NC raw input (PB5).";

CM_ BO_ 304 "0x130 PowerStage DEVICE_ADDR / bootloader RX. byte0=0xFF DLC=2 resets into bootloader, which re-handles XCP CONNECT on the same ID.";
CM_ SG_ 304 PS_Device_Command "0xFF (DLC=2) = software reset and re-enter OpenBLT bootloader.";
CM_ BO_ 305 "0x131 PowerStage bootloader TX (XCP responses).";
CM_ BO_ 320 "0x140 PowerStage CMD_FAN: set fan mode and manual duty cycle. Accepted from both CAN buses.";
CM_ SG_ 320 PS_Fan_Mode "0=OFF 1=ON_MANUAL 2=AUTO. In AUTO mode Fan_Duty is ignored.";
CM_ SG_ 320 PS_Fan_Duty "Manual duty cycle 0-100%. Applied only when Fan_Mode=1.";
CM_ SG_ 320 PS_Fan_Min_Duty "AUTO-mode floor duty. Carried only by the DLC=5 form.";
CM_ SG_ 320 PS_Fan_Auto_On_Temp "AUTO-mode switch-on temperature. DLC=5 form only.";
CM_ SG_ 320 PS_Fan_Auto_Off_Temp "AUTO-mode switch-off temperature. DLC=5 form only.";
CM_ BO_ 321 "0x141 PowerStage CMD_HS: per-rail enable bits (1 byte, bit0=AUX..bit4=SBC). Accepted from both CAN buses.";
CM_ SG_ 321 PS_HS_Cmd_AUX "0=disable RAIL_AUX 1=enable.";
CM_ SG_ 321 PS_HS_Cmd_LED "0=disable RAIL_LED 1=enable.";
CM_ SG_ 321 PS_HS_Cmd_DRIVE "0=disable RAIL_DRIVE 1=enable.";
CM_ SG_ 321 PS_HS_Cmd_CAP "0=disable RAIL_CAP 1=enable.";
CM_ SG_ 321 PS_HS_Cmd_SBC "IGNORED. SBC rail has no MCU-driven EN line (permanently enabled by hardware). Bit reserved.";
CM_ BO_ 322 "0x142 PowerStage CMD_OC: set per-rail software OC warning thresholds (mA, big-endian). Frame is byte-for-byte symmetric with PS_BCAST_OC_CFG_A. 0 disables software OC on a given rail. RAIL_SBC has no MCU EN and is not in this frame. Use CMD_OC_RESET (0x148) to clear latched faults. Persist with CMD_EEPROM 0x01.";
CM_ SG_ 322 PS_OC_Thr_AUX_mA "RAIL_AUX software OC warning threshold in mA, big-endian. 0 = disabled.";
CM_ SG_ 322 PS_OC_Thr_LED_mA "RAIL_LED software OC warning threshold in mA, big-endian. 0 = disabled.";
CM_ SG_ 322 PS_OC_Thr_DRIVE_mA "RAIL_DRIVE software OC warning threshold in mA, big-endian. 0 = disabled.";
CM_ SG_ 322 PS_OC_Thr_CAP_mA "RAIL_CAP software OC warning threshold in mA, big-endian. 0 = disabled.";
CM_ BO_ 328 "0x148 PowerStage CMD_OC_RESET: clear latched software OC warn flags. For each set bit, the rail is re-enabled and its warn/fault flag cleared.";
CM_ SG_ 328 PS_OC_Reset_AUX "1 = clear latched OC warn for RAIL_AUX and re-enable.";
CM_ SG_ 328 PS_OC_Reset_LED "1 = clear latched OC warn for RAIL_LED and re-enable.";
CM_ SG_ 328 PS_OC_Reset_DRIVE "1 = clear latched OC warn for RAIL_DRIVE and re-enable.";
CM_ SG_ 328 PS_OC_Reset_CAP "1 = clear latched OC warn for RAIL_CAP and re-enable.";
CM_ BO_ 323 "0x143 PowerStage CMD_EEPROM: 0x01 saves live config; 0x02 restores factory defaults.";
CM_ SG_ 323 PS_EEPROM_Cmd "0x01=save live config to EEPROM. 0x02=load factory defaults and overwrite EEPROM.";
CM_ BO_ 324 "0x144 PowerStage CMD_UV: update UV trip thresholds for V24, VCAP, V12 in mV big-endian.";
CM_ SG_ 324 PS_UV_V24_mV "New UV trip threshold for V24 bus in mV big-endian.";
CM_ SG_ 324 PS_UV_VCAP_mV "New UV trip threshold for VCAP bus in mV big-endian.";
CM_ SG_ 324 PS_UV_V12_mV "New UV trip threshold for V12 bus in mV big-endian.";
CM_ BO_ 325 "0x145 PowerStage CMD_CTRL: control V_LED_PWR output and CAN1<->CAN2 relay enable.";
CM_ SG_ 325 PS_V_LED_PWR_Cmd "0=OFF 1=ON. Controls V_LED_PWR output (PC0).";
CM_ SG_ 325 PS_CAN_Relay_Enable "0=disable 1=enable. Controls CAN1<->CAN2 frame forwarding.";
CM_ BO_ 326 "0x146 PowerStage CMD_PAGE_DWELL: set OLED per-page dwell in 500 ms ticks. Each byte 0 = use default (10 ticks = 5 s). Persist with CMD_EEPROM 0x01.";
CM_ SG_ 326 PS_Page_Dwell_Overview "OLED Page 0 dwell. Raw value is 500 ms ticks; scale 0.5 → seconds.";
CM_ SG_ 326 PS_Page_Dwell_RailStatus "OLED Page 1 dwell. Ticks of 500 ms; scale 0.5 → seconds.";
CM_ SG_ 326 PS_Page_Dwell_FaultDetail "OLED Page 2 dwell. Ticks of 500 ms; scale 0.5 → seconds.";
CM_ BO_ 327 "0x147 PowerStage CMD_BAT_CFG: set battery SOC-low warning threshold (%). 0 = disable. Persist with CMD_EEPROM 0x01.";
CM_ SG_ 327 PS_Bat_Low_SOC_Threshold_pct "Battery low-SOC warning trip point in %. 0 disables warning entirely.";
CM_ BO_ 336 "0x150 PowerStage BCAST_HS_STATE: per-rail enable / fault / pgood / OC-warn / OC-fault bits.";
CM_ BO_ 337 "0x151 PowerStage BCAST_HS_CURR_A: BAT, CAP, SBC, DRIVE currents (uint16 mA big-endian).";
CM_ SG_ 337 PS_I_BAT_mA "Battery input current.";
CM_ SG_ 337 PS_I_CAP_mA "Capacitor rail current.";
CM_ SG_ 337 PS_I_SBC_mA "SBC rail current.";
CM_ SG_ 337 PS_I_DRIVE_mA "Drive rail current.";
CM_ BO_ 338 "0x152 PowerStage BCAST_VOLTAGE: V24, VCAP, V12 (mV BE), UV/SOC-low flags, and battery SOC %.";
CM_ SG_ 338 PS_V24_mV "24V bus voltage in mV big-endian.";
CM_ SG_ 338 PS_VCAP_mV "Capacitor bus voltage in mV big-endian.";
CM_ SG_ 338 PS_V12_mV "12V bus voltage in mV big-endian.";
CM_ SG_ 338 PS_UV_Fault_V24 "1 = V24 below UV trip.";
CM_ SG_ 338 PS_UV_Fault_VCAP "1 = VCAP below UV trip.";
CM_ SG_ 338 PS_UV_Fault_V12 "1 = V12 below UV trip.";
CM_ SG_ 338 PS_Battery_SOC_Low_Flag "1 = filtered SOC strictly below configured low-SOC threshold (CMD_BAT_CFG, default 40%).";
CM_ SG_ 338 PS_Battery_SOC_pct "6S Li pack SOC (0-100 %), OCV+IR compensated, EMA + asymmetric hysteresis filtered.";
CM_ BO_ 339 "0x153 PowerStage BCAST_FAN: fan mode, duty, NTC temperature (int16 degCx10, scale 0.1).";
CM_ SG_ 339 PS_Fan_Mode_State "Current active fan mode.";
CM_ SG_ 339 PS_Fan_Duty_State "Current active PWM duty cycle.";
CM_ SG_ 339 PS_Temperature_C "NTC temperature, scale 0.1 °C.";
CM_ SG_ 339 PS_Fan_Min_Duty_State "Live AUTO-mode floor duty.";
CM_ SG_ 339 PS_Fan_Auto_On_Temp_State "Live AUTO-mode switch-on temperature.";
CM_ SG_ 339 PS_Fan_Auto_Off_Temp_State "Live AUTO-mode switch-off temperature.";
CM_ BO_ 340 "0x154 PowerStage BCAST_EEPROM: live echo of EEPROM-stored boot config.";
CM_ SG_ 340 PS_Cfg_HS_Def_AUX "Boot-default enable state for RAIL_AUX.";
CM_ SG_ 340 PS_Cfg_HS_Def_LED "Boot-default enable state for RAIL_LED.";
CM_ SG_ 340 PS_Cfg_HS_Def_DRIVE "Boot-default enable state for RAIL_DRIVE.";
CM_ SG_ 340 PS_Cfg_HS_Def_CAP "Boot-default enable state for RAIL_CAP.";
CM_ SG_ 340 PS_Cfg_HS_Def_SBC "Boot-default enable state for RAIL_SBC (ignored on this board, no MCU EN).";
CM_ BO_ 341 "0x155 PowerStage BCAST_HS_CURR_B: AUX, LED rail currents (uint16 mA BE).";
CM_ BO_ 342 "0x156 PowerStage BCAST_UV: currently active UV thresholds.";
CM_ BO_ 343 "0x157 PowerStage BCAST_OC_CFG_A: AUX, LED, DRIVE, CAP OC thresholds (mA, big-endian). Byte-for-byte equal to CMD_OC — use this echo to confirm what was applied. RAIL_SBC is uncontrollable and not broadcast.";
CM_ BO_ 345 "0x159 PowerStage BCAST_IO_STATUS: SW pin / V_LED_PWR / CAN relay state.";
CM_ BO_ 346 "0x15A PowerStage BCAST_BATTERY_CFG: static 6S battery refs (cutoff, full, R_int, cell count). Defaults: 19.6 V / 25.2 V / 200 mΩ / 6S.";
CM_ SG_ 346 PS_Bat_Cutoff_mV "0 % SOC reference voltage (mV). Default 19600 (3.27 V/cell × 6).";
CM_ SG_ 346 PS_Bat_Full_mV "100 % SOC reference voltage (mV). Default 25200 (4.20 V/cell × 6).";
CM_ SG_ 346 PS_Bat_Rint_mOhm "Pack internal resistance (mΩ) used for IR compensation.";
CM_ SG_ 346 PS_Bat_Cell_Count "Series cell count (6 for 6S Li-ion / Li-Po).";

CM_ BO_ 352 "0x160 LEDDriver DEVICEID / bootloader RX. byte0=0xFF DLC=2 resets into bootloader, which re-handles XCP CONNECT on the same ID.";
CM_ BO_ 353 "0x161 LEDDriver bootloader TX (XCP responses).";
CM_ BO_ 368 "0x170 LEDDriver CMD_LIGHTSET: 3-channel PWM duty (0-100% per channel).";
CM_ BO_ 369 "0x171 LEDDriver CMD_VOLTAGESET: UV thresholds (V24, V17.5) big-endian + buck mode (byte 4: 0=OFF, 1=ON, 2=AUTO). DLC=4 form preserves previous mode.";
CM_ BO_ 370 "0x172 LEDDriver CMD_EEPROMSET: Save and/or LoadDefault flags. Save processed first.";
CM_ SG_ 370 LED_EEPROM_Save_Flag "1 = snapshot live config to EEPROM (bit0).";
CM_ SG_ 370 LED_EEPROM_LoadDefault_Flag "1 = restore factory defaults and overwrite EEPROM (bit1).";
CM_ BO_ 376 "0x178 LEDDriver BCAST_EEPROMDATA: EEPROM config echo (UV thresholds + PWM defaults + buck mode).";
CM_ BO_ 377 "0x179 LEDDriver BCAST_LIGHTSTATUS: live PWM levels, voltages, and a wrapping heartbeat counter.";
CM_ BO_ 378 "0x17A LEDDriver BCAST_DEVSTATUS: system state + per-bit error flags.";
CM_ SG_ 378 LED_Err_UV_24V "1 = 24V rail undervoltage (bit 0 of legacy Error_Code byte).";
CM_ SG_ 378 LED_Err_UV_17V5 "1 = 17.5V rail undervoltage (bit 1 of legacy Error_Code byte).";

