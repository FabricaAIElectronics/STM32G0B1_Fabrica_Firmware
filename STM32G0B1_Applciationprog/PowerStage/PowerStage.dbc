VAL_ 304 Device_Command 255 "RESET_BOOTLOADER" ;
VAL_ 320 Fan_Mode 0 "OFF" 1 "ON_MANUAL" 2 "AUTO" ;
VAL_ 321 HS_Cmd_AUX 0 "DISABLE" 1 "ENABLE" ;
VAL_ 321 HS_Cmd_LED 0 "DISABLE" 1 "ENABLE" ;
VAL_ 321 HS_Cmd_DRIVE 0 "DISABLE" 1 "ENABLE" ;
VAL_ 321 HS_Cmd_CAP 0 "DISABLE" 1 "ENABLE" ;
