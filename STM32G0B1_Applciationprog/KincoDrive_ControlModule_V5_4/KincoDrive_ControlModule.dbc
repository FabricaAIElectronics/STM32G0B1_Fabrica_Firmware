 SG_ Fan_DR_Tach : 0|8@1+ (1,0) [0|100] "%" Host
 SG_ Fan_EP_Tach : 8|8@1+ (1,0) [0|100] "%" Host
 SG_ Fan_EH_Tach : 16|8@1+ (1,0) [0|100] "%" Host
 SG_ Fan_ST_Tach : 24|8@1+ (1,0) [0|100] "%" Host
 SG_ Fan_SF_Tach : 32|8@1+ (1,0) [0|100] "%" Host

