# Host unit tests. Built with the NATIVE compiler, not the ARM cross-compiler.
CC      ?= gcc
CFLAGS  ?= -std=c11 -Wall -Wextra -O0 -g -I. -Ifakes
BINDIR  := build

TESTS   := test_can_layout test_thermistor_math test_battery_soc test_i2c_host_proto test_encoder_math
BINS    := $(addprefix $(BINDIR)/,$(TESTS))

# PowerStage sources compiled directly into a test. battery.c includes only
# battery.h, which includes only <stdint.h>/<stdbool.h>, so it builds on the
# host with no HAL stubs at all.
PS_CORE := ../../STM32G0B1_Applciationprog/PowerStage/Core

.PHONY: all clean
all: $(BINS)
	@for b in $(BINS); do ./$$b || exit 1; done

# Headers are prerequisites, not just include paths.
#
# Without them make compares each binary against its .c file alone, so editing
# layouts.h changes nothing that make can see and the stale binary is re-run.
# That is worse than a missed rebuild: layouts.json is GENERATED by this binary
# and is what the conformance stage checks the DBC against, so a stale binary
# makes conformance compare the DBC to an old layout table and report a
# mismatch against the file that was actually correct. Caught when a CMD_FAN
# DLC change kept failing conformance after layouts.h had already been updated.
#
# $< is used in the recipe rather than $^ so the headers are not passed to the
# compiler as inputs.
HEADERS := harness.h layouts.h

$(BINDIR)/%: %.c $(HEADERS) | $(BINDIR)
	$(CC) $(CFLAGS) -o $@ $< -lm

# Explicit rule wins over the pattern rule above: this one also compiles and
# links the real firmware module, so the assertions test shipped code rather
# than a restatement of it.
$(BINDIR)/test_battery_soc: test_battery_soc.c $(PS_CORE)/Src/battery.c \
                            $(PS_CORE)/Inc/battery.h $(HEADERS) | $(BINDIR)
	$(CC) $(CFLAGS) -I$(PS_CORE)/Inc -o $@ \
	      test_battery_soc.c $(PS_CORE)/Src/battery.c -lm

BB_CORE := ../../STM32G0B1_Applciationprog/STM32G0_BUTTONBOARD_PROG/Core
$(BINDIR)/test_encoder_math: test_encoder_math.c $(BB_CORE)/Inc/encoder_math.h $(HEADERS) | $(BINDIR)
	$(CC) $(CFLAGS) -I$(BB_CORE)/Inc -o $@ test_encoder_math.c -lm
$(BINDIR)/test_i2c_host_proto: test_i2c_host_proto.c $(BB_CORE)/Src/i2c_host_proto.c \
                               $(BB_CORE)/Inc/i2c_host_proto.h $(HEADERS) | $(BINDIR)
	$(CC) $(CFLAGS) -I$(BB_CORE)/Inc -o $@ \
	    test_i2c_host_proto.c $(BB_CORE)/Src/i2c_host_proto.c -lm

$(BINDIR):
	mkdir -p $(BINDIR)

clean:
	rm -rf $(BINDIR) layouts.json
