#!/usr/bin/env sh
# Launcher for the Fabrica bench tool.
#
#   ./fab                  open the TUI
#   ./fab doctor           run a single command
#   ./fab verify knob --allow-transmit
#
# Exists so the operator types `./fab` instead of
# `python3 fabrica_cli.py --iface can0 --firmware <somewhere> tui`. The CAN
# interface and the firmware directory are auto-detected; pass --iface or
# --firmware to override.
#
# Named `fab` because `fabrica` is the Python package directory next to this
# file. Put it on PATH under whatever name you like:
#
#   sudo ln -s "$PWD/fab" /usr/local/bin/fabrica
set -eu

# Resolve symlinks so the script finds fabrica_cli.py next to its real self
# rather than next to the link. `readlink -f` is absent on macOS and some BSDs,
# so walk the chain by hand.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *)  target=$(dirname "$target")/$link ;;
    esac
done
here=$(cd "$(dirname "$target")" && pwd)

for py in python3 python; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$here/fabrica_cli.py" "$@"
    fi
done

echo "fab: no python3 on PATH." >&2
echo "  Debian/Ubuntu:  sudo apt install python3 python3-pip" >&2
exit 127
