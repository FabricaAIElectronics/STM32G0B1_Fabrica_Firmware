 SG_ ADC_PTC1_PTC2 : 0|8@1+ (1,0) [0|255] "" Host
 SG_ ADC_PTC3_PTC4 : 8|8@1+ (1,0) [0|255] "" Host
 SG_ ADC_PTC5_PTC6 : 16|8@1+ (1,0) [0|255] "" Host
 SG_ ADC_CURR1_CURR2 : 24|8@1+ (1,0) [0|255] "" Host
 SG_ ADC_CURR3_V24 : 32|8@1+ (1,0) [0|255] "" Host
 SG_ ADC_V12_CURR24V : 40|8@1+ (1,0) [0|255] "" Host

BO_ 294 Bcast_Config_A: 8 KincoDrive
 SG_ Cfg_HS_State : 0|8@1+ (1,0) [0|15] "" Host
 SG_ Cfg_OC_DR_mA : 8|16@1+ (1,0) [0|65535] "mA" Host
 SG_ Cfg_OC_EXT_mA : 24|16@1+ (1,0) [0|65535] "mA" Host
 SG_ Cfg_OC_SC_mA : 40|16@1+ (1,0) [0|65535] "mA" Host

BO_ 295 Bcast_Config_B: 8 KincoDrive
 SG_ Cfg_UV_24V_mV : 0|16@1+ (1,0) [0|65535] "mV" Host
 SG_ Cfg_UV_12V_mV : 16|16@1+ (1,0) [0|65535] "mV" Host
 SG_ Cfg_Fan_DR_Default : 32|8@1+ (1,0) [0|100] "%" Host
 SG_ Cfg_Fan_EP_Default : 40|8@1+ (1,0) [0|100] "%" Host
 SG_ Cfg_Fan_EH_Default : 48|8@1+ (1,0) [0|100] "%" Host
 SG_ Cfg_Fan_ST_Default : 56|8@1+ (1,0) [0|100] "%" Host


CM_ BU_ KincoDrive "KincoDrive Control Module V5.4 (low-level driver build). 11-bit standard IDs in CANopen-safe gap 0x101-0x12F. Bootloader RX 0x101 / TX 0x102. Protections: OC per HS channel + UV per bus only.";
CM_ BU_ Host "Host controller / CAN analyzer.";

CM_ BO_ 257 "OpenBLT bootloader RX (0x101). DLC=2, byte0=0xFF triggers app reset; bootloader then re-handles XCP CONNECT on the same ID.";
CM_ BO_ 258 "OpenBLT bootloader TX (0x102). XCP responses target->host while in bootloader.";
CM_ BO_ 272 "CMD 0x110: high-side power control. DLC=1 bitmask (bit0=Drive bit1=Extruder bit2=Scrubbing bit3=12V_Buck). Setting an HS bit also clears any latched OC error for that channel.";
CM_ BO_ 273 "CMD 0x111: fan PWM speeds. DLC=5. One byte per fan (0-100%). Order DR/EP/EH/ST/SF.";
CM_ BO_ 274 "CMD 0x112: EEPROM action. DLC=1. Byte0: 0=load defaults and apply, 1=snapshot current state to EEPROM.";
CM_ BO_ 275 "CMD 0x113: per-channel OC thresholds. DLC=6. uint16 LE per channel (DR/EXT/SC) in mA. RAM-only; persist with Cmd_EEPROM.";
CM_ BO_ 276 "CMD 0x114: undervoltage thresholds. DLC=4. uint16 LE for V24 then V12 in mV. RAM-only; persist with Cmd_EEPROM.";

CM_ BO_ 288 "BCAST 0x120: voltages, 24V bus current, system state, error mask. Period: ~167 ms (phase 0 of 3).";
CM_ BO_ 289 "BCAST 0x121: 24V bus + per-HS module currents in mA. Period: ~167 ms (phase 0 of 3).";
CM_ BO_ 290 "BCAST 0x122: 6 PTC thermistor temperatures. Wire: value = degC + 40. Period: ~167 ms (phase 0 of 3).";
CM_ BO_ 291 "BCAST 0x123: fan tachometer % (0-100). Period: ~167 ms (phase 1 of 3).";
CM_ BO_ 292 "BCAST 0x124: full raw GPIO state - HS EN/PG/FT for 3 channels, VBUCK_EN, B1, Toggle_Pos_Detect, LED2. No interpretation. Period: ~167 ms (phase 1 of 3).";
CM_ BO_ 293 "BCAST 0x125: 12 ADC channels packed as 4-bit nibbles (raw>>8). Period: ~167 ms (phase 1 of 3).";
CM_ BO_ 294 "BCAST 0x126: EEPROM config part A - HS boot state + per-channel OC thresholds. Period: ~167 ms (phase 2 of 3).";
CM_ BO_ 295 "BCAST 0x127: EEPROM config part B - UV thresholds + fan boot defaults. Period: ~167 ms (phase 2 of 3).";

CM_ SG_ 288 Sys_State "0=INIT 1=LOAD_CONFIG 2=RUNNING.";
CM_ SG_ 288 Error_Mask "Bitmask: bit0=OC_DR, bit1=OC_EXT, bit2=OC_SC, bit3=UV_24V, bit4=UV_12V. OC bits latch until host re-enables the channel; UV bits auto-clear on recovery (500 mV hysteresis).";
CM_ SG_ 292 HS_DR_PwrGood "TPS2493 PGOOD pin (asserted when rail healthy).";
CM_ SG_ 292 HS_E_PwrGood "TPS2493 PGOOD pin (asserted when rail healthy).";
CM_ SG_ 292 HS_SC_PwrGood "TPS2493 PGOOD pin (asserted when rail healthy).";
CM_ SG_ 292 HS_DR_Fault "TPS2493 FAULT pin (asserted when fault present).";
CM_ SG_ 292 HS_E_Fault "TPS2493 FAULT pin (asserted when fault present).";
CM_ SG_ 292 HS_SC_Fault "TPS2493 FAULT pin (asserted when fault present).";
CM_ SG_ 292 B1_Pin "Blue button raw input (PC13).";
CM_ SG_ 292 Toggle_Pos_Detect "Toggle position detect raw input (PC0).";
CM_ SG_ 292 LED2_Out "LED2 output state (PA5, heartbeat).";
CM_ SG_ 293 ADC_PTC1_PTC2 "Hi nibble=PTC1, Lo nibble=PTC2 (raw ADC >> 8)";
CM_ SG_ 293 ADC_PTC3_PTC4 "Hi nibble=PTC3, Lo nibble=PTC4";
CM_ SG_ 293 ADC_PTC5_PTC6 "Hi nibble=PTC5, Lo nibble=PTC6";
CM_ SG_ 293 ADC_CURR1_CURR2 "Hi nibble=CURR_MON_1 (Drive), Lo nibble=CURR_MON_2 (Extruder)";
CM_ SG_ 293 ADC_CURR3_V24 "Hi nibble=CURR_MON_3 (Scrubbing), Lo nibble=VADC_24";
CM_ SG_ 293 ADC_V12_CURR24V "Hi nibble=VADC_12, Lo nibble=CURR_MON_24V";

