CM_ BU_ Host "Supervisory host or CAN analyzer. Issues commands to the three Fabrica devices and consumes their broadcasts.";
CM_ BU_ KincoDrive "Fabrica KincoDrive Control Module V5.4. Standard 11-bit IDs in 0x101-0x12F. Bootloader RX 0x101 / TX 0x102.";
CM_ BU_ PowerStage "Fabrica PowerStage Controller. Standard 11-bit IDs in 0x130-0x15F. Bootloader RX 0x130 / TX 0x131. Dual-bus relay (FDCAN1 internal, FDCAN2 host).";
CM_ BU_ LEDDriver "Fabrica 3-channel LED Driver. Standard 11-bit IDs in 0x160-0x17F. Bootloader RX 0x160 / TX 0x161.";

CM_ BO_ 257 "0x101 KincoDrive bootloader RX. byte0=0xFF DLC=2 = XCP CONNECT (also resets running app into bootloader).";
CM_ BO_ 258 "0x102 KincoDrive bootloader TX (XCP responses).";
CM_ BO_ 275 "0x113 KincoDrive: per-channel OC thresholds, uint16 LE × 3 (DR/EXT/SC) in mA.";
CM_ BO_ 276 "0x114 KincoDrive: undervoltage thresholds, uint16 LE × 2 (V24/V12) in mV.";
CM_ BO_ 295 "0x127 KincoDrive: BCAST_CONFIG_B - UV thresholds + fan boot defaults from EEPROM.";
CM_ SG_ 288 KD_Sys_State "0=INIT 1=LOAD_CONFIG 2=RUNNING";
CM_ SG_ 288 KD_Error_Mask "Bitmask: bit0=OC_DR bit1=OC_EXT bit2=OC_SC bit3=UV_24V bit4=UV_12V";
CM_ BO_ 304 "0x130 PowerStage DEVICE_ADDR / bootloader RX. byte0=0xFF DLC=2 resets into bootloader.";
CM_ BO_ 305 "0x131 PowerStage bootloader TX.";
CM_ BO_ 352 "0x160 LEDDriver DEVICEID / bootloader RX. byte0=0xFF DLC=2 resets into bootloader.";
CM_ BO_ 353 "0x161 LEDDriver bootloader TX.";

