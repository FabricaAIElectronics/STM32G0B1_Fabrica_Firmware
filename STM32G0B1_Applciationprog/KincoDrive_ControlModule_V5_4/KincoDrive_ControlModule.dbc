CM_ BU_ KincoDrive "KincoDrive Control Module V5.4 - Device ID 0x0667 - TEST MODE (broadcast only)";
CM_ BU_ Host "Host controller / CAN analyzer";
CM_ BO_ 2248148583 "System status: endstops, bus voltages, protection state, system state, error count. Period: 500ms.";
CM_ BO_ 2248214119 "Current measurements: 24V bus and per-module high-side currents. Period: 500ms.";
CM_ BO_ 2248279655 "Temperatures: 6 PTC thermistors. Wire encoding: value = degC + 40. Period: 500ms.";
CM_ BO_ 2248345191 "Fan speeds: tachometer percentage of max RPM. Period: 500ms.";
CM_ BO_ 2248410727 "Raw GPIO status: HS enable/PG/fault pins, ESTOP, endstop raw states, LED, button. Period: 500ms.";
CM_ BO_ 2248476263 "Raw ADC: 12 channels packed as 4-bit nibbles (12-bit >> 8). Period: 500ms.";
CM_ SG_ 2248148583 Endstop_Triggered "Bit0=EH_Top, Bit1=EH_Bot, Bit2=EP_Top, Bit3=EP_Bot, Bit4=SC_Top, Bit5=ESTOP";
CM_ SG_ 2248148583 Endstop_Fault "Same bit layout. 1=wiring fault detected.";
CM_ SG_ 2248148583 Protection_State "Bits[1:0]=Drive_OC, [3:2]=Ext_OC, [5:4]=Scrub_OC, [7:6]=OV_state";
CM_ SG_ 2248148583 System_State "0=NORMAL, 1=WARNING, 2=ERROR, 3=RECOVERY";
CM_ SG_ 2248410727 HS_Enable_Pins "Bit0=DR_EN, Bit1=E_EN, Bit2=SC_EN, Bit3=VBUCK_CTRL";
CM_ SG_ 2248410727 HS_PowerGood_Pins "Bit0=DR_PG, Bit1=E_PG, Bit2=SC_PG (1=power good)";
CM_ SG_ 2248410727 HS_Fault_Pins "Bit0=DR_FT, Bit1=E_FT, Bit2=SC_FT (1=fault active)";
CM_ SG_ 2248410727 ESTOP_Raw "Bit0=NO_pin, Bit1=NC_pin, Bit2=debounced_state";
CM_ SG_ 2248410727 Endstop_Raw_1 "Bit0=EH_H_NO, Bit1=EH_H_NC, Bit2=EH_L_NO, Bit3=EP_H_NO, Bit4=EP_H_NC, Bit5=EP_L_NO, Bit6=EP_L_NC, Bit7=SC_H_NO";
CM_ SG_ 2248410727 Endstop_Raw_2 "Bit0=SC_H_NC";
CM_ SG_ 2248476263 ADC_PTC1_PTC2 "Hi nibble=PTC1, Lo nibble=PTC2 (raw ADC >> 8)";
CM_ SG_ 2248476263 ADC_PTC3_PTC4 "Hi nibble=PTC3, Lo nibble=PTC4 (raw ADC >> 8)";
CM_ SG_ 2248476263 ADC_PTC5_PTC6 "Hi nibble=PTC5, Lo nibble=PTC6 (raw ADC >> 8)";
CM_ SG_ 2248476263 ADC_CURR1_CURR2 "Hi nibble=CURR_MON_1, Lo nibble=CURR_MON_2 (raw ADC >> 8)";
CM_ SG_ 2248476263 ADC_CURR3_V24 "Hi nibble=CURR_MON_3, Lo nibble=VADC_24 (raw ADC >> 8)";
CM_ SG_ 2248476263 ADC_V12_CURR24V "Hi nibble=VADC_12, Lo nibble=CURR_MON_24V (raw ADC >> 8)";

