 SG_ HS_DR_Enable : 0|1@1+ (1,0) [0|1] "" Host
 SG_ HS_E_Enable : 1|1@1+ (1,0) [0|1] "" Host
 SG_ HS_SC_Enable : 2|1@1+ (1,0) [0|1] "" Host
 SG_ VBUCK_Enable : 3|1@1+ (1,0) [0|1] "" Host
 SG_ HS_DR_PwrGood : 8|1@1+ (1,0) [0|1] "" Host
 SG_ HS_E_PwrGood : 9|1@1+ (1,0) [0|1] "" Host
 SG_ HS_SC_PwrGood : 10|1@1+ (1,0) [0|1] "" Host
 SG_ HS_DR_Fault : 16|1@1+ (1,0) [0|1] "" Host
 SG_ HS_E_Fault : 17|1@1+ (1,0) [0|1] "" Host
 SG_ HS_SC_Fault : 18|1@1+ (1,0) [0|1] "" Host
 SG_ B1_Pin : 24|1@1+ (1,0) [0|1] "" Host
 SG_ Toggle_Pos_Detect : 25|1@1+ (1,0) [0|1] "" Host
 SG_ LED2_Out : 32|1@1+ (1,0) [0|1] "" Host

