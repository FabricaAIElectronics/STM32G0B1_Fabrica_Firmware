# ---------------------------------------------------------------------------
# Build output.
#
# Every project regenerates these. They were tracked until now, which meant an
# ordinary rebuild produced a 500+ file diff and made merges between the board
# branches conflict on object files. Rebuild instead:
#
#   stm32cubeidec.exe --launcher.suppressErrors -nosplash \
#     -application org.eclipse.cdt.managedbuilder.core.headlessbuild \
#     -data <scratch-workspace> -importAll <project-dir> -cleanBuild "<Name>/Debug"
# ---------------------------------------------------------------------------
Debug/
Release/
build/

# ---------------------------------------------------------------------------
# Eclipse / STM32CubeIDE workspace state.
#
# .metadata/ is per-workspace scratch, not source. It also contains paths deep
# enough to break `git clone` on Windows' 260-character path limit.
# ---------------------------------------------------------------------------
.metadata/
RemoteSystemsTempFiles/
mx.scratch
*.bak
*~

# ---------------------------------------------------------------------------
# STM32CubeIDE per-workspace language settings.
#
# These carry an env-hash fingerprint of the machine and workspace that last
# built the project, so every headless build rewrites them. Tracking them
# guarantees churn and cross-machine conflicts; they are regenerated on demand.
# ---------------------------------------------------------------------------
**/.settings/language.settings.xml

# ---------------------------------------------------------------------------
# Python bytecode from the V&V gate and its tests
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------------------
# V&V host unit-test output. vv/unit/build/ is already covered by the bare
# build/ rule above; layouts.json is regenerated by `make -C vv/unit`.
# ---------------------------------------------------------------------------
vv/unit/layouts.json

# ---------------------------------------------------------------------------
# Staged firmware artifacts.
#
# Tools/fabrica/firmware/ is populated by `python vv/run_gate.py
# --stage-artifacts` and copied to the target machine. The binaries themselves
# stay out of git -- attach them to a tagged release instead. manifest.json is
# generated alongside them and would go stale the moment either changed.
# ---------------------------------------------------------------------------
Tools/fabrica/firmware/**/*.srec
Tools/fabrica/firmware/**/*.dbc
Tools/fabrica/firmware/**/manifest.json

# ---------------------------------------------------------------------------
# Bench-local binaries and vendored python, both filled by prepare-offline.sh.
#
# tools/ holds openocd and BootCommander for one platform. openocd alone is
# 17 MB and architecture-specific -- an aarch64 build is useless on x86 and
# neither runs on Windows -- so a committed set for every platform would be
# 50 MB+ and would still need libusb/libftdi/libhidapi installed on the host.
# The README explaining that IS tracked; the binaries are not.
# ---------------------------------------------------------------------------
Tools/fabrica/tools/*
!Tools/fabrica/tools/README.md
Tools/fabrica/vendor/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
